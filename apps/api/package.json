{
  "name": "veritas-backend",
  "version": "1.6.0",
  "description": "Back-end REST API para o Analisador IA - Veritas",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node scripts/copy-sql.cjs",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:init": "tsx src/database/init.ts"
  },
  "keywords": [
    "veritas",
    "ai-analyzer",
    "express",
    "ocr",
    "desinformacao",
    "fraude-digital",
    "link-suspeito"
  ],
  "author": "Equipe Veritas",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.26.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ipaddr.js": "1.9.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
