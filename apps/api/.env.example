# Node >=22.13. Use npm run setup para gerar segredo JWT exclusivo.
PORT=3001
JWT_SECRET=

# local não chama um modelo. Para agentes com IA gratuita: groq + sua chave.
AI_PROVIDER=local
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_MAX_OUTPUT_TOKENS=1800
AI_DAILY_REQUEST_LIMIT=40
AI_DAILY_TOKEN_LIMIT=40000
AI_MINUTE_TOKEN_LIMIT=7200
AI_MIN_INTERVAL_MS=2200
# IA complementar de links com pesquisa. Use false para poupar a chamada de IA.
LINK_USE_AI=true

# Adaptador preservado para estudo. Bloqueado na orquestração desta versão protegida.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Lista comunitária gratuita OpenPhish, cache local atualizado a cada 12h.
REPUTATION_ENABLED=true
# Base adicional completa de URLs HTTP/HTTPS, sem chave, com cache de 12 horas.
PHISHING_DATABASE_ENABLED=true
# Opcional: habilitar Safe Browsing v4 em projeto Google e criar chave.
SAFE_BROWSING_API_KEY=

# Pesquisa pública e leitura de até cinco páginas antes do parecer; sem chave adicional.
FACTCHECK_ENABLED=true

USE_POSTGRES=false
# Não apague data/ai-usage.db: registra o consumo e as reservas após reiniciar.
# DATA_DIR=./data
# SQLITE_DB_PATH=./data/veritas.db
# AI_USAGE_DB_PATH=./data/ai-usage.db
# OCR_LANG_PATH=./data/tessdata
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veritas

# Acesso administrativo: conceda somente a uma conta existente com npm run admin:configurar.
ADMIN_USER_ID=
ADMIN_EMAIL=
