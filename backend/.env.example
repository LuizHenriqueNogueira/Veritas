# ========================================================
# Analisador IA - Veritas - Variáveis de Ambiente
# ========================================================

# Porta do servidor back-end
PORT=3001

# Segredo para assinatura de tokens JWT
JWT_SECRET=veritas_super_secret_jwt_key_2026

# Chave da API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/)
# Quando informada, os 3 agentes utilizarão modelos de IA generativa em tempo real.
# Caso não informada, o sistema executará com seu motor heurístico local offline.
GEMINI_API_KEY=

# Banco de Dados:
# Por padrão, o sistema utiliza banco de dados persistente SQLite em `backend/data/veritas.db`
# Se desejar utilizar PostgreSQL, defina USE_POSTGRES=true e configure a DATABASE_URL:
USE_POSTGRES=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veritas
