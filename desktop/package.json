{
  "name": "veritas-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Interface Desktop React/Electron para o Analisador IA - Veritas",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite",
    "dev": "concurrently -k \"vite --port 3000\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.64.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
